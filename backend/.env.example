# Flood-Flash Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True

# Database (SQLite default, can be updated to PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/flood_flash
DATABASE_URL=sqlite:///./flood_flash.db

# Twilio WhatsApp Sandbox Setup
# Join sandbox by texting "join <sandbox-code>" to +1 415 523 8886 on WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Background Sensor Simulation / Re-scoring Interval (seconds)
SIMULATION_INTERVAL_SECONDS=60

# JWT Authentication Secret Key (REQUIRED in production & dev)
JWT_SECRET_KEY=replace-with-a-long-random-value

